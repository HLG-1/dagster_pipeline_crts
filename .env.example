# Copier en .env et remplir. Ne jamais committer le .env reel.

# Token Hugging Face (repo gated facebook/sam3), utilise par le service SAM3
HF_TOKEN=your_hugging_face_token_here

SAM3_DEVICE=cuda
SAM3_DTYPE=float16

# URL du service SAM3
# - Pour le dev local (sans docker): http://127.0.0.1:8077
# - Dans Docker Compose (automatiquement géré par docker-compose.yml): http://sam3:8077
SAM3_URL=http://127.0.0.1:8077

# Chemin des poids YOLO fine-tunes (placer le fichier best.pt dans checkpoints/yolo11/best.pt)
YOLO_WEIGHTS_PATH=checkpoints/yolo11/best.pt

# Dossier de sortie par defaut des runs
OUTPUT_DIR=results

# Racine Dagster (utilisee par dagster.yaml / DAGSTER_HOME)
DAGSTER_HOME=.dagster_home
